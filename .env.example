# Everything here is optional. `docker compose up -d` works with no .env at
# all. Copy this to .env (gitignored) and uncomment only the lines you want.

# --- basics ------------------------------------------------------------------
# What players type into the Minecraft client. The dashboard shows and pings
# it. For players outside your network: a DNS name (or IP) that reaches this
# host, with port 25565 forwarded. No CDN or proxy: Minecraft is not HTTP.
# MC_PUBLIC_HOST=localhost
# Timezone for logs and the backup schedule (06:00 and 18:00).
# TZ=Etc/UTC
# The panel's footer asks api.github.com twice a day whether a newer kPanel
# release exists. 0 = never contact GitHub for this.
# KPANEL_UPDATE_CHECK=1

# --- compose/lan.yml: reach the panel from your network -----------------------
# Required by that overlay, which refuses to start without them.
# KPANEL_BASIC_AUTH=admin:change-me-to-something-long
# FILES_PASSWORD=change-me-too

# --- compose/tailscale.yml: reach it from anywhere, over your tailnet ---------
# Device name and tailnet domain form the URLs: https://<TS_HOSTNAME>.<TS_TAILNET>/
# and :8443. The domain is in the Tailscale admin console ("tail1234.ts.net").
# The auth key must be TAGLESS; single-use is enough. See docs/tailscale.md.
# TS_HOSTNAME=kpanel
# TS_TAILNET=tail1234.ts.net
# TS_AUTHKEY=tskey-auth-...

# --- the Settings page (optional) ---------------------------------------------
# Edits server.properties by opening pull requests against your fork of this
# repository, so git keeps the history. Hidden until both are set. The token is
# a fine-grained PAT for that one repository: Contents and Pull requests,
# read and write.
# KPANEL_GITHUB_REPO=your-github-user/your-fork
# KPANEL_GITHUB_TOKEN=github_pat_...
