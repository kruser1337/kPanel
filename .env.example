# Everything here is optional. `docker compose up -d` works with no .env at
# all. Copy this to .env (gitignored) and uncomment only the lines you want.

# --- basics ------------------------------------------------------------------
# What players type into the Minecraft client. The dashboard shows and pings
# it. For players outside your network: a DNS name (or IP) that reaches this
# host, with port 25565 forwarded. No CDN or proxy: Minecraft is not HTTP.
# MC_PUBLIC_HOST=localhost
# Timezone for logs and the backup schedule (06:00 and 18:00).
# TZ=Etc/UTC
# The panel's footer asks api.github.com twice a day whether a newer kPanel
# release exists. 0 = never contact GitHub for this.
# KPANEL_UPDATE_CHECK=1
# Without a login the panel answers only to localhost (DNS-rebinding
# protection). Other names you open it by, comma-separated; * for any.
# KPANEL_ALLOWED_HOSTS=minecraft.home.lan

# --- compose/lan.yml: reach the panel from your network -----------------------
# Required by that overlay: the panel refuses to start without a login.
# The file manager comes along at /files/, behind the same login (since 0.3;
# FILES_PASSWORD is no longer used and can go).
# The panel's login is a hash, never the password. With the stack running,
#   docker compose exec kpanel python hashpw.py
# asks for a password and prints the line to paste here. Keep its single
# quotes: without them compose reads each $ in the hash as a variable.
# KPANEL_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
# KPANEL_USER=admin
# Deprecated: the panel password in plain text, user:password. Still read, with
# a warning; kPanel 0.4 refuses it. Replace it with KPANEL_PASSWORD_HASH.
# KPANEL_BASIC_AUTH=

# --- compose/tailscale.yml: reach it from anywhere, over your tailnet ---------
# Device name and tailnet domain form the URLs: https://<TS_HOSTNAME>.<TS_TAILNET>/
# and :8443. The domain is in the Tailscale admin console ("tail1234.ts.net").
# The auth key must be TAGLESS; single-use is enough. See docs/tailscale.md.
# TS_HOSTNAME=kpanel
# TS_TAILNET=tail1234.ts.net
# TS_AUTHKEY=tskey-auth-...

# --- Settings through git (optional) -------------------------------------------
# By default the Settings page writes server.properties directly. With both of
# these set, it opens pull requests against your fork of this repository
# instead, so git keeps the history. The token is a fine-grained PAT for that
# one repository: Contents and Pull requests, read and write.
# KPANEL_GITHUB_REPO=your-github-user/your-fork
# KPANEL_GITHUB_TOKEN=github_pat_...
